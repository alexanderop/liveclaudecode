{
  "extends": "./.nuxt/tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    ".nuxt/types/nitro-imports.d.ts",
    "test/unit/**/*.ts",
    "test/e2e/**/*.ts",
    "test/fixtures/**/*.ts",
    "test/browser/**/*.ts",
    "test/desktop/**/*.ts",
    "electron/**/*.d.ts",
    "playwright.config.ts",
    "playwright.desktop.config.ts",
    "vitest.config.ts"
  ]
}
