#!/usr/bin/env node
import process from 'node:process'
import { existsSync, readFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { createRequire } from 'node:module'
import { fileURLToPath, pathToFileURL } from 'node:url'
import { spawn } from 'node:child_process'

const packageRoot = dirname(dirname(fileURLToPath(import.meta.url)))
const packageJson = JSON.parse(readFileSync(join(packageRoot, 'package.json'), 'utf8'))

export function parseArguments(argv) {
  const options = {
    project: '',
    port: 8787,
    host: '127.0.0.1',
    hours: 168,
    open: false,
    desktop: false,
    portExplicit: false,
  }
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index]
    if (argument === '-p' || argument === '--port') {
      options.port = Number(argv[++index])
      options.portExplicit = true
    }
    else if (argument === '--host') options.host = argv[++index]
    else if (argument === '--hours') options.hours = Number(argv[++index])
    else if (argument === '--open') options.open = true
    else if (argument === '--desktop') options.desktop = true
    else if (argument === '-V' || argument === '--version') options.version = true
    else if (argument === '-h' || argument === '--help') options.help = true
    else if (argument?.startsWith('-')) throw new Error(`Unknown option: ${argument}`)
    else if (!options.project) options.project = argument || ''
    else throw new Error(`Unexpected argument: ${argument}`)
  }
  if (!Number.isInteger(options.port) || options.port < 1 || options.port > 65_535) {
    throw new Error('Port must be an integer between 1 and 65535')
  }
  if (!Number.isFinite(options.hours) || options.hours < 0) {
    throw new Error('Hours must be a non-negative number')
  }
  return options
}

function help() {
  return `liveclaudecode ${packageJson.version}

Usage: liveclaudecode [project] [options]

Arguments:
  project              optional repo path or Claude project-storage slug

Options:
  -p, --port <port>    port to bind (default: 8787)
      --host <host>    host to bind (default: 127.0.0.1)
      --hours <hours>  only show recently touched runs (default: 168 / 7 days)
      --open           open the viewer in a browser
      --desktop        open the viewer in the Electron desktop shell
  -V, --version        print the version
  -h, --help           show this help`
}

/**
 * Launch the Electron desktop shell instead of a server plus browser tab. The
 * shell hosts the same built dashboard in its own process, so it needs the
 * production build and the optional `electron` dependency.
 */
function startDesktop(options, outputEntry) {
  if (!existsSync(outputEntry)) {
    console.error('The desktop shell needs the production build. Run pnpm build first.')
    return 1
  }
  let electronBinary
  try {
    electronBinary = createRequire(import.meta.url).resolve('electron')
  } catch {
    console.error('Electron is not installed. Run pnpm add -D electron to use --desktop.')
    return 1
  }
  const require = createRequire(electronBinary)
  const env = {
    ...process.env,
    LCC_PROJECT: options.project,
    LCC_HOURS: String(options.hours),
    LCC_HOST: options.host,
    LCC_PORT: options.portExplicit ? String(options.port) : '',
  }
  console.log(`watching : ${options.project || 'local Claude + Codex sessions'}`)
  console.log('opening  : desktop window')
  const child = spawn(require('electron'), [packageRoot], { cwd: process.cwd(), env, stdio: 'inherit' })
  child.on('exit', (code) => { process.exitCode = code ?? 0 })
  for (const signal of ['SIGINT', 'SIGTERM']) {
    process.on(signal, () => child.kill(signal))
  }
  return 0
}

function openBrowser(url) {
  const command = process.platform === 'darwin' ? 'open' : process.platform === 'win32' ? 'cmd' : 'xdg-open'
  const args = process.platform === 'win32' ? ['/c', 'start', '', url] : [url]
  const child = spawn(command, args, { detached: true, stdio: 'ignore' })
  child.unref()
}

export function main(argv = process.argv.slice(2)) {
  let options
  try {
    options = parseArguments(argv)
  } catch (error) {
    console.error(error instanceof Error ? error.message : String(error))
    console.error('Run liveclaudecode --help for usage.')
    return 2
  }
  if (options.help) {
    console.log(help())
    return 0
  }
  if (options.version) {
    console.log(packageJson.version)
    return 0
  }

  const url = `http://${options.host}:${options.port}`
  const outputEntry = join(packageRoot, '.output', 'server', 'index.mjs')
  if (options.desktop) return startDesktop(options, outputEntry)

  const nuxtEntry = join(packageRoot, 'node_modules', 'nuxt', 'bin', 'nuxt.mjs')
  const production = existsSync(outputEntry)
  if (!production && !existsSync(nuxtEntry)) {
    console.error('Nuxt dependencies are missing. Run pnpm install first.')
    return 1
  }

  const env = {
    ...process.env,
    LCC_PROJECT: options.project,
    LCC_HOURS: String(options.hours),
    NUXT_LCC_PROJECT: options.project,
    NUXT_LCC_HOURS: String(options.hours),
    HOST: options.host,
    PORT: String(options.port),
    NITRO_HOST: options.host,
    NITRO_PORT: String(options.port),
  }
  const command = process.execPath
  const args = production
    ? [outputEntry]
    : [nuxtEntry, 'dev', packageRoot, '--host', options.host, '--port', String(options.port)]

  console.log(`watching : ${options.project || 'local Claude + Codex sessions'}`)
  console.log(`open     : ${url}`)
  if (options.open) openBrowser(url)

  const child = spawn(command, args, { cwd: process.cwd(), env, stdio: 'inherit' })
  child.on('exit', code => { process.exitCode = code ?? 0 })
  for (const signal of ['SIGINT', 'SIGTERM']) {
    process.on(signal, () => child.kill(signal))
  }
  return 0
}

if (process.argv[1] && pathToFileURL(process.argv[1]).href === import.meta.url) {
  process.exitCode = main()
}
