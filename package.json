{
  "name": "liveclaudecode",
  "version": "0.2.0",
  "description": "Local live browser for Claude Code, OpenAI Codex, GitHub Copilot CLI, and VS Code Copilot Chat sessions",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "liveclaudecode": "./bin/liveclaudecode",
    "lcc": "./bin/liveclaudecode"
  },
  "scripts": {
    "build": "nuxt build",
    "check": "pnpm lint && pnpm test && pnpm test:types && pnpm test:browser",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test",
    "test:browser:prebuilt": "playwright test",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "vitest run --project e2e",
    "test:types": "nuxt typecheck && vue-tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@comark/nuxt": "0.5.1",
    "@dagrejs/dagre": "^1.1.8",
    "@effect/platform-node": "4.0.0-beta.101",
    "@iconify-json/lucide": "1.2.119",
    "@nuxt/ui": "4.10.0",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "effect": "4.0.0-beta.101",
    "nuxt": "4.4.8",
    "tailwindcss": "4.3.3",
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.101",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "4.0.3",
    "@playwright/test": "1.58.2",
    "@types/node": "24.13.2",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.11.1",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.6"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.15.0"
}
